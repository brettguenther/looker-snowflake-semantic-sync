# ============================================================================
# Snowflake Connection & Authentication Settings
# ============================================================================
# Account identifier (e.g., "xy12345.us-central1.gcp" or "orgname-accountname")
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC

# Auth Mode: "key_pair" | "oauth" | "oauth_client_credentials" | "externalbrowser"
SNOWFLAKE_AUTH_MODE=key_pair

# --- Option A: Key-Pair Authentication (SNOWFLAKE_AUTH_MODE=key_pair) ---
# Provide EITHER a file path to your PKCS#8 private key (.p8 / .pem) OR the raw/base64 PEM content:
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_RAW=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Option B: OAuth Access Token (SNOWFLAKE_AUTH_MODE=oauth) ---
SNOWFLAKE_OAUTH_TOKEN=

# --- Option C: OAuth Client Credentials (SNOWFLAKE_AUTH_MODE=oauth_client_credentials) ---
SNOWFLAKE_OAUTH_CLIENT_ID=
SNOWFLAKE_OAUTH_CLIENT_SECRET=
SNOWFLAKE_OAUTH_TOKEN_URL=
SNOWFLAKE_OAUTH_SCOPE=

# ============================================================================
# Looker SDK & Project Settings (Optional if running with --no-deploy)
# ============================================================================
LOOKERSDK_BASE_URL=https://<your-instance>.cloud.looker.com
LOOKERSDK_CLIENT_ID=
LOOKERSDK_CLIENT_SECRET=
LOOKERSDK_VERIFY_SSL=true

LOOKER_PROJECT_ID=snowflake_semantics
LOOKER_CONNECTION_NAME=snowflake_default
LOOKER_MODEL_NAME=snowflake_semantic_model
# Optional: looker-cli profile name (preferred over LOOKERSDK_* when set)
LOOKER_PROFILE=
# Optional: explicit Looker dev branch to checkout before --deploy
LOOKER_DEV_BRANCH=

# ============================================================================
# GitOps Pull Request Settings (Optional if running with --pr)
# ============================================================================
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
# Any of GITHUB_TOKEN, GITHUB_PAT, or GITHUB_PERSONAL_ACCESS_TOKEN is accepted
GITHUB_TOKEN=
